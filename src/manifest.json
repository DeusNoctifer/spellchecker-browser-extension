{
  "manifest_version": 2,
  "name": "Spellchecker",
  "version": "1.0",
  "description": "Lightweight browser extension for real-time English grammar correction.",
  "background": {
    "scripts": ["background.js"]
  },

  "permissions": [
    "activeTab",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}