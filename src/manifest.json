{
  "manifest_version": 3,
  "name": "Spellchecker",
  "version": "1.0",
  "description": "Corrige palabras en inglés conectándose a una API inteligente.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}